// Seamless tiling (removes pane borders and title frames, leaving only thin separators)
pane_frames false

keybinds {
    // 1. Global bindings (except locked mode) for tab switching
    shared_except "locked" {
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        unbind "Alt Right"
        unbind "Alt right"
        unbind "Alt Left"
        unbind "Alt left"
        unbind "Alt f"
        unbind "Alt F"
        bind "Alt Shift Right" { MoveFocusOrTab "Right"; }
        bind "Alt Shift Left" { MoveFocusOrTab "Left"; }
    }

    // 2. Release Ctrl+o for Neovim and map Session mode to Alt+o instead
    shared_except "session" "locked" {
        unbind "Ctrl o"
        bind "Alt o" { SwitchToMode "Session"; }
    }

    // 3. Ensure Alt+o toggles back to Normal mode when already in Session mode
    session {
        unbind "Ctrl o"
        bind "Alt o" { SwitchToMode "Normal"; }
    }
}
