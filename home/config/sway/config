include variables
include input
include output
include workspaces
include windowrules
include keybinds/*

exec_always ~/.config/sway/scripts/apply-layout

# Hide default sway bar completely - noctalia-shell provides its own
bar {
    mode invisible
}

# Launch noctalia at startup
exec noctalia
exec keyd-application-mapper -d
exec discord

# systemd integration: export Wayland and X11 env vars so systemd user services
# (like clipboard-sync) know which displays to use and can authenticate.
exec systemctl --user set-environment XAUTHORITY=/home/trevor/.Xauthority
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
# NOTE: wl-paste/xclip bridge removed — sway syncs the XWayland clipboard
# natively; the bridge formed a feedback loop that emptied the clipboard
# (broke copying out of Proton games). Use wl-clip-persist or cliphist if
# clipboard persistence is ever needed.

include /etc/sway/config.d/*
