include variables
include input
include output
include windowrules
include workspaces
include keybinds/*

# Hide default sway bar completely - noctalia-shell provides its own
bar {
    mode invisible
}

# Launch noctalia-shell at startup
exec qs -c noctalia-shell
exec keyd-application-mapper -d
exec noisetorch
exec vesktop


include /etc/sway/config.d/*
